{
  "name": "gbif-phylo",
  "private": true,
  "description": "Monorepo of the phylogenetic tree viewer: a framework-free viewer, a React wrapper, tree operations and tree file parsers.",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/io",
    "packages/tree-ops",
    "packages/viewer",
    "packages/react",
    "examples/*",
    "tests/browser"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w packages/io -w packages/tree-ops -w packages/viewer -w packages/react",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:packages": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "esbuild": "0.21.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "engines": {
    "node": ">=22.7"
  }
}
