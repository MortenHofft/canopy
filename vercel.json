{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'dependencies are installed per candidate inside scripts/build-site.mjs'",
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "site-dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)\\.(nwk|nex|nexus|tsv|csv|fa|fasta|txt|json|xml)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/data/(.*)\\.gz",
      "headers": [
        { "key": "Content-Type", "value": "application/gzip" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/(.*)/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
