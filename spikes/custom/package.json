{
  "name": "spike-custom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --port 5306 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"bench/*.mjs\" \"test/*.mjs\" vite.config.ts eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"bench/*.mjs\" \"test/*.mjs\" vite.config.ts eslint.config.js",
    "test": "node --experimental-transform-types --no-warnings --test --test-concurrency=4 \"test/**/*.test.mjs\"",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.0",
    "vite": "5.4.11"
  }
}
