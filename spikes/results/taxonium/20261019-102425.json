{
 "runId": "20261019-102425",
 "candidate": {
  "name": "taxonium",
  "version": "2.1.24",
  "license": "GPL-3.0",
  "notes": "DEMO ONLY, GPL-3.0, not for shipping. React 19, WebGL (deck.gl 9.1.14 bundled), singleton worker. Camera, colours and settings are reached through React fiber props of the library's inner Deck component."
 },
 "capabilities": {
  "tipClick": {
   "level": "yes",
   "how": "onNodeSelect(node_id) then onNodeDetailsLoaded(node_id, details); details.name is the tip label. The event reaches us only after the worker answered the details request (about 50 ms debounce plus a round trip)"
  },
  "internalNodeClick": {
   "level": "partial",
   "how": "Internal nodes have no marker: a click on the node's branch line selects it (pickingRadius 10 px). Same callbacks as tips; the node name comes back as n<preorder> because the adapter named the internal nodes in the Newick it wrote. The root has no edge and cannot be selected"
  },
  "branchClick": {
   "level": "partial",
   "how": "A branch click IS the node selection (the line object is the child node); the library cannot tell the two apart, so it is reported as nodeClick"
  },
  "hover": {
   "level": "no",
   "how": "No hover prop or callback in 2.1.24. The library shows its own hover tooltip and ring internally (useHoverDetails), which we cannot subscribe to"
  },
  "descendantTipsInPayload": {
   "level": "no",
   "how": "Details carry num_tips, not the tip list (the side panel has a separate \"list\" request that no callback exposes). Tip sets are computed from the TreeModel (source adapter-derived); num_tips is cross-checked in libraryPayload"
  },
  "cladeColouring": {
   "level": "partial",
   "how": "Colours TIP DOTS only (branches use one line colour from settings; internal nodes have no dots unless the internal-markers option is on). Done by giving every tip a unique key (TSV column) and pushing a key-to-RGB map into the library's own colour state through setAdditionalColorMapping (React fiber props of the inner Deck). O(tips) per change; the library recolours without a reload"
  },
  "highlightTip": {
   "level": "partial",
   "how": "query.srch / query.enabled (controlled prop): a text_per_line search on the tip name draws red rings (fixed colour list, radius 5 px). Debounced 500 ms plus a worker round trip; matching is case-insensitive; at most 10k results"
  },
  "focusTip": {
   "level": "partial",
   "how": "No prop. Calls the library's own view.setViewState (React fiber props of the inner Deck) with a new zoom and target; instant, no animation. query.zoomToSearch exists but is read only when the component mounts (useState initialiser), so it cannot refocus a loaded tree"
  },
  "tipAsLink": {
   "level": "partial",
   "how": "DOM overlay: real a[href][data-tip-id] elements for rows at least 8 px tall (the WebGL labels stay under them); other tips have no anchor"
  },
  "customColumns": {
   "level": "no",
   "how": "No aligned per-tip columns. Metadata TSV columns only appear in the hover tooltip, the side panel and as a colour-by field"
  },
  "alignmentColumn": {
   "level": "no",
   "how": "No alignment column (the JBrowse panel is for mutation-annotated trees of the Treenome kind, not for sequences from a FASTA)"
  },
  "radialLayout": {
   "level": "no",
   "how": "Rectangular only: the layers are horizontal and vertical lines on an orthographic view (useLayers.tsx)"
  },
  "branchLengthToggle": {
   "level": "partial",
   "how": "The library always lays out with branch lengths (useDistances is forced true in the worker). A cladogram is obtained by writing the Newick without lengths and remounting the component (full reload of the tree). x_time exists only for jsonl/Nextstrain files, so xType cannot switch a Newick tree"
  },
  "scaleBar": {
   "level": "no",
   "how": "No scale bar or time axis in the main view for a Newick tree (no axis layer in useLayers.tsx)"
  },
  "darkTheme": {
   "level": "partial",
   "how": "Host background via CSS; line, label and dot colours by the library settings setters (React fiber props). The library's own chrome (buttons, tooltips, hover ring, selection ring, minimap) is fixed light/black and does not follow"
  },
  "cssTokens": {
   "level": "partial",
   "how": "Background, line colour, tip colour and label colour from the GBIF tokens through settings setters and the colour mapping. Not possible: label font (hard-coded Roboto in the TextLayer), highlight colour, selection ring, tooltip chrome, minimap colours"
  },
  "multipleInstances": {
   "level": "no",
   "how": "useLocalBackend.ts creates ONE module-level Worker and global onQueryReceipt/onConfigReceipt callbacks: a second <Taxonium> replaces the first one's tree (see S13)"
  },
  "cleanUnmount": {
   "level": "partial",
   "how": "React unmount tears down deck.gl, but the module-level worker is never terminated and keeps the last parsed tree in memory (see S13 and the leak probe)"
  },
  "controlledState": {
   "level": "partial",
   "how": "query/updateQuery control search, colour field and x axis. Selection, camera and colour mapping are internal state (reached through fiber props)"
  },
  "zoomToFit": {
   "level": "partial",
   "how": "The library's default view is a fixed zoom/target, not a fit; the adapter fits on mount through view.setViewState. The in-canvas reset button returns to the library default, not to our fit"
  },
  "overviewOrMinimap": {
   "level": "yes",
   "how": "Built-in minimap (top right) showing the whole de-overplotted tree and the viewport; click to pan. Toggle in Library options (settings.toggleMinimapEnabled)"
  }
 },
