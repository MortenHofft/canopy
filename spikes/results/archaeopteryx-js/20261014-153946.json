{
 "runId": "20261014-153946",
 "candidate": {
  "name": "archaeopteryx-js",
  "version": "3.24.0",
  "license": "LGPL-3.0-or-later",
  "notes": "Full viewer application driven imperatively (launch/destroy); d3 7.9.0 and phyloxml 1.1.7 put on globalThis for the UMD file; panel collapsed by default."
 },
 "capabilities": {
  "tipClick": {
   "level": "partial",
   "how": "no click callback in the library; adapter listens for DOM clicks and maps them to the node (d3 datum or layout coordinates): adapter-derived"
  },
  "internalNodeClick": {
   "level": "partial",
   "how": "same workaround; internal nodes without a label are found by layout coordinates (rectangular only)"
  },
  "branchClick": {
   "level": "no",
   "how": "no branch elements (branches are batched into a few paths); clicks on a branch hit the nearest node"
  },
  "hover": {
   "level": "partial",
   "how": "library shows its own tooltip, no callback; adapter-derived hover events from a DOM mousemove hit test"
  },
  "descendantTipsInPayload": {
   "level": "no",
   "how": "the library has no payload; tip sets are computed by the adapter from the shared TreeModel (source adapter-derived)"
  },
  "cladeColouring": {
   "level": "partial",
   "how": "sets the phyloXML node.color on the library's live node objects and forces a redraw with applyViewState({}); the library has no colour-a-clade API"
  },
  "highlightTip": {
   "level": "partial",
   "how": "search box A via applyViewState({searchA: regex on node name}); the library bolds the hits, adds a halo and dims everything else; no per-tip style API"
  },
  "focusTip": {
   "level": "partial",
   "how": "search A + the library's documented Ctrl+Shift+E and Ctrl+G shortcuts dispatched on document; no focus/zoom-to API"
  },
  "tipAsLink": {
   "level": "partial",
   "how": "tip labels are SVG <text>; the adapter overlays <a href data-tip-id> over the visible labels (up to 400), re-positioned on each redraw"
  },
  "customColumns": {
   "level": "partial",
   "how": "only through built-ins: numeric columns become heat-map columns (>=2), text columns become label text or Color-by; no custom cell renderers"
  },
  "alignmentColumn": {
   "level": "yes",
   "how": "mol_seq on tip nodes; built-in alignment track (windowed, with conservation bar or sequence logo)"
  },
  "radialLayout": {
   "level": "yes",
   "how": "layout: 'circular' (also 'unrooted'); heat map as rings, alignment track rectangular only"
  },
  "branchLengthToggle": {
   "level": "yes",
   "how": "applyViewState({display: 'phylogram' | 'cladogram'}); a tree drawn to scale needs > 50% positive lengths"
  },
  "scaleBar": {
   "level": "yes",
   "how": "scale bar always drawn for phylograms; showScaleAxis adds an axis (time axis for dated trees)"
  },
  "darkTheme": {
   "level": "partial",
   "how": "library has its own light/dark switch (button, localStorage 'aptx-panel-theme'); adapter clicks it; the dark palette is the library's, not GBIF's"
  },
  "cssTokens": {
   "level": "partial",
   "how": "no token contract; adapter overrides default-coloured SVG fills/strokes with CSS !important selectors and re-points the panel's --p-* custom properties"
  },
  "multipleInstances": {
   "level": "no",
   "how": "module singleton: a second launch() replaces the first (README: \"One viewer per page\")"
  },
  "cleanUnmount": {
   "level": "yes",
   "how": "viewer.destroy() removes DOM, body-level tooltip/menu, resize and key/wheel listeners"
  },
  "controlledState": {
   "level": "partial",
   "how": "view state both ways (applyViewState / onViewChange); no selection, viewport or colour setters"
  },
  "zoomToFit": {
   "level": "yes",
   "how": "fits on launch and on window resize; Ctrl+0 and a panel button refit"
  },
  "overviewOrMinimap": {
   "level": "yes",
   "how": "built-in overview miniature (always shown, cannot be switched off by config)"
  }
 },
