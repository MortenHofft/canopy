{
 "runId": "20261014-151310",
 "candidate": {
  "name": "tbrowse",
  "version": "2.10.0",
  "license": "MIT",
  "notes": "Flat node table + pluggable row-aligned zones; SVG tree zone, DOM label/column zones, canvas MSA zone; native-scroll virtualised rows, no zoom."
 },
 "capabilities": {
  "tipClick": {
   "level": "yes",
   "how": "click on a leaf row, branch or label sets ViewState.selectedNodeId (library state); the adapter turns the change into a tipClick event"
  },
  "internalNodeClick": {
   "level": "yes",
   "how": "click on an internal branch or collapsed triangle sets ViewState.selectedNodeId; the library also opens its own tooltip with collapse / prune / swap / reroot actions"
  },
  "branchClick": {
   "level": "partial",
   "how": "the branch hit path IS the click target of its child node; branch and node clicks are the same event (reported as nodeClick)"
  },
  "hover": {
   "level": "yes",
   "how": "ZoneRenderProps.hoveredNodeId inside our own zone body (fires only while that zone is visible); not available through TBrowseProps"
  },
  "descendantTipsInPayload": {
   "level": "no",
   "how": "the library reports only a node id (selectedNodeId); tip sets are computed from the shared TreeModel and flagged source=adapter-derived (hoveredSubtreeIds exists but only in zone render props)"
  },
  "cladeColouring": {
   "level": "partial",
   "how": "no colour prop in the library: inline style patched on the tree SVG branches and leaf dots (path d parsed back to a node through mirrored row geometry) plus React-rendered colour in our tips and column zones; internal-node glyphs and dashed leaders stay grey; re-patched by a MutationObserver"
  },
  "highlightTip": {
   "level": "partial",
   "how": "library search state (host SearchField) draws a ring on the leaf dot and marks collapsed triangles; our zones add a row band; typing in the library search box replaces it"
  },
  "focusTip": {
   "level": "partial",
   "how": "scrolls the library .tbrowse-outer scroll container to centre the row (DOM access, no API); un-collapses and un-prunes ancestors through ViewState first"
  },
  "tipAsLink": {
   "level": "partial",
   "how": "real <a href data-tip-id target=_blank> rendered by our own label zone (ZoneDefinition) for rows in the virtualised range; the built-in labels zone has no links"
  },
  "customColumns": {
   "level": "yes",
   "how": "one ZoneDefinition per column (Header + Body from ZoneRenderProps.visibleRows/rowRange, data via the hostData prop); rows stay aligned because every zone shares the same row grid"
  },
  "alignmentColumn": {
   "level": "partial",
   "how": "built-in msaZone fed from MSA {alphabet,length,sequences} keyed by geneId = tip label; canvas is as tall as ALL rows, so it goes blank beyond the browser canvas limit (about 1,365 rows at 24 px, source-derived); one alignment only"
  },
  "radialLayout": {
   "level": "no",
   "how": "rectangular phylogram/cladogram only (TreeZoneState.layoutMode)"
  },
  "branchLengthToggle": {
   "level": "yes",
   "how": "TreeZoneState.layoutMode phylogram | cladogram through controlled viewState; adapter rescales lengths (absolute 0.01 floor in the library); optional // compression of long branches is a separate toggle"
  },
  "scaleBar": {
   "level": "no",
   "how": "no scale bar or time axis in the tree zone"
  },
  "darkTheme": {
   "level": "yes",
   "how": "theme=\"dark\" prop plus CSS custom properties (--tbrowse-*) re-pointed at gbifDarkTheme() values"
  },
  "cssTokens": {
   "level": "partial",
   "how": "--tbrowse-* custom properties on .tbrowse-root take GBIF token values (bg, text, branch, accent, borders); fixed in code: selection amber, branch width by clade size, glyph sizes, residue colours; no per-node style callbacks"
  },
  "multipleInstances": {
   "level": "yes",
   "how": "zustand store per <TBrowse>; only global is one injected <style id=tbrowse-theme-style>"
  },
  "cleanUnmount": {
   "level": "yes",
   "how": "React unmount; the document keydown listener for the search hotkey is removed (and disabled here with hotkeys={{search:false}})"
  },
  "controlledState": {
   "level": "yes",
   "how": "viewState / onViewStateChange (selection, collapse, prune, swap, zone widths and states, search, row height) controlled from React state"
  },
  "zoomToFit": {
   "level": "partial",
   "how": "no zoom: fixed 24 px rows in a native scroll container. ViewState.rowHeight can be set to fit all rows (the \"fit\" row-height option) but then every row, SVG node and label is drawn (no culling benefit)"
  },
  "overviewOrMinimap": {
   "level": "partial",
   "how": "no minimap or semantic zoom; collapsedNodeIds turns clades into triangle rows (the adapter \"overview\" option picks them), the MSA zone has its own coverage minimap"
  }
 },
