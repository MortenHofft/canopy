  "tipClick": {
   "level": "yes",
   "how": "delegated click on the tip dot or label"
  },
  "internalNodeClick": {
   "level": "yes",
   "how": "click on a node dot"
  },
  "branchClick": {
   "level": "yes",
   "how": "click on a branch path; reported as branchClick with the clade below it"
  },
  "hover": {
   "level": "yes",
   "how": "mouseover on dots/branches/labels gives tipHover / nodeHover"
  },
  "descendantTipsInPayload": {
   "level": "yes",
   "how": "every event carries the descendant tips (from the shared TreeModel inside the renderer; source is reported as library because the stub renderer is the library)"
  },
  "cladeColouring": {
   "level": "yes",
   "how": "imperative stroke on the existing paths of the subtree range; no redraw, no layout change"
  },
  "highlightTip": {
   "level": "yes",
   "how": "class on the tip dot plus a row band and a ring"
  },
  "focusTip": {
   "level": "yes",
   "how": "sets row height to at least 24 px and centres the tip row; instant, no animation"
  },
  "tipAsLink": {
   "level": "partial",
   "how": "real <a href data-tip-id target=_blank> but only for rows that are rendered (rows >= 9 px); other tips have no DOM node"
  },
  "customColumns": {
   "level": "yes",
   "how": "bar, text and alignment columns drawn on one canvas for visible rows"
  },
  "alignmentColumn": {
   "level": "yes",
   "how": "coloured residue runs on the columns canvas"
  },
  "radialLayout": {
   "level": "yes",
   "how": "polar coordinates, arcs; columns are not drawn in radial layout"
  },
  "branchLengthToggle": {
   "level": "yes",
   "how": "phylogram (cumulative length) versus cladogram (tips aligned); negative lengths clamped to 0"
  },
  "scaleBar": {
   "level": "no",
   "how": "no scale bar or time axis"
  },
  "darkTheme": {
   "level": "yes",
   "how": "gbifDarkTheme() values (derived from tokens; GBIF has no dark set) as CSS custom properties on the root element"
  },
  "cssTokens": {
   "level": "yes",
   "how": "defaults come from gbifTheme() (GBIF tokens); background, foreground, branch, highlight, fontFamily override the --sp-* custom properties"
  },
  "multipleInstances": {
   "level": "yes",
   "how": "no module state; two instances were tested via window.__spike2"
  },
  "cleanUnmount": {
   "level": "yes",
   "how": "React unmount removes the DOM; rAF cancelled; no global listeners except window pointer listeners removed on pointerup"
  },
  "controlledState": {
   "level": "yes",
   "how": "colour, highlight, focus, layout, lengths, columns, theme, links are props of the View"
  },
  "zoomToFit": {
   "level": "partial",
   "how": "fits on mount and layout change; no API to refit; wheel zoom-out is limited to 0.3x of the fit"
  },
  "overviewOrMinimap": {
   "level": "no",
   "how": "none; every node is drawn at all zoom levels (no level of detail)"
  }
