{
  "name": "gbif-phylo-spikes",
  "private": true,
  "version": "0.1.0",
  "description": "Shared test harness for the phylogenetic tree viewer spikes. Candidate apps are independent packages, NOT workspaces.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["runner"],
  "scripts": {
    "typecheck": "tsc -p shared/tsconfig.json",
    "check:catalogue": "node runner/check-catalogue.mjs",
    "test:parser": "node --test shared/test/parser.test.mjs",
    "run": "node runner/run.mjs",
    "report": "node runner/report.mjs"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
