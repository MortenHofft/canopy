{
  "name": "@canopy/io",
  "version": "0.1.0",
  "private": true,
  "description": "Iterative, quote-aware Newick and NEXUS parsers and a Newick writer, producing a preorder TreeModel on typed arrays.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "@canopy/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/browser/io.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node ../../scripts/bundle-browser.mjs io",
    "bench": "node --conditions=@canopy/source --experimental-transform-types --no-warnings bench/nexus.mjs",
    "bench:posterior": "node --conditions=@canopy/source --experimental-transform-types --no-warnings bench/posterior.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@canopy/source --experimental-transform-types --no-warnings --test \"test/**/*.test.mjs\""
  }
}
