{
  "name": "@gbif-phylo/tree-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Operations a user applies to a phylogenetic tree: reroot, midpoint root, ladderise, rotate, collapse, prune, subtree. Pure TypeScript on typed arrays; no rendering, no dependencies.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "@gbif-phylo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@gbif-phylo/source --experimental-transform-types --no-warnings --test \"test/*.mjs\"",
    "bench": "node --conditions=@gbif-phylo/source --max-old-space-size=8192 --experimental-transform-types bench/tree-ops.mjs",
    "bench:bytes": "node --conditions=@gbif-phylo/source --expose-gc --max-old-space-size=8192 --experimental-transform-types bench/tree-bytes.mjs"
  },
  "devDependencies": {
    "@gbif-phylo/io": "0.1.0"
  }
}
